{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "moduleSuffixes": [".service.d", ""],
    "types": ["node"]
  },
  "include": [
    "runtime/conversationContracts.ts",
    "runtime/diagnosticContracts.ts",
    "runtime/executionContracts.ts",
    "runtime/admission/private/reporting.ts",
    "runtime/nodeContentContracts.ts",
    "generated/runtime.d.ts",
    "generated/lab-env.d.ts",
    "runtime.service.d.ts",
    "lab.ts",
    "lab/**/*.ts",
    "shared/**/*.ts",
    "../src/browser/runtimeTerminalResult.ts",
    "../src/apps/lab/content/promptLibrary.ts",
    "conversations/*.ts",
    "implementations/*/conversation.ts",
    "implementations/originalRealtime/input.ts",
    "providers/cascade/*.ts",
    "runtime/admission/private/composition.ts",
    "runtime/admission/private/definition.ts",
    "runtime/admission/private/implementation.ts",
    "runtime/conversationAdmission.ts",
    "runtime/conversationConnection.ts",
    "runtime/conversationNode.ts",
    "runtime/conversationObserve.ts",
    "runtime/conversationUsage.ts",
    "runtime/gateTestOptions.ts",
    "runtime/implementationContracts.ts",
    "runtime/interviewFinalizationComposition.ts",
    "runtime/interviewFinalizationEffectPolicy.ts",
    "runtime/interviewFinalizationModel.ts",
    "runtime/interviewFinalizationPersistenceDecoder.ts",
    "runtime/nativeContracts.ts",
    "runtime/nativeWorkOwner.ts",
    "runtime/runtimeEvents.ts",
    "runtime/runtimeHostAssembly.ts",
    "runtime/runtimeUsage.ts",
    "runtime/toolCallRecord.ts"
  ],
  "exclude": [
    "conversations/**/*.test.ts",
    "lab/**/*.test.ts",
    "shared/**/*.test.ts",
    "shared/testing/**/*.ts",
    "providers/cascade/*.test.ts",
    "providers/cascade/*.typecheck.ts"
  ]
}
