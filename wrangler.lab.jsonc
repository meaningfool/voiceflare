{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eventpulse-lab",
  "main": "worker/lab.ts",
  "compatibility_date": "2026-06-05",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/lab/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/@fs/*",
      "!/@id/*",
      "!/@react-refresh",
      "!/@vite/*",
      "!/node_modules/*",
      "!/src/*",
    ],
  },
  "d1_databases": [
    {
      "binding": "LAB_DB",
      "database_name": "eventpulse-lab",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "worker/migrations",
    },
  ],
  "services": [
    {
      "binding": "RUNTIME_WORKER",
      "service": "eventpulse-runtime",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "LAB_STARTUP_DEADLINE", "class_name": "LabStartupDeadline" }],
  },
  "migrations": [
    { "tag": "v1_lab_startup_deadline", "new_sqlite_classes": ["LabStartupDeadline"] },
  ],
  "dev": {
    "port": 8795,
    "local_protocol": "http",
  },
  "triggers": {
    "crons": ["7 3 * * *"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "secrets": {
    "required": [],
  },
}
