{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "worker/shared/contracts/conversationSelection.ts",
    "worker/shared/contracts/resultWarnings.ts",
    "worker/shared/contracts/cascadeMedia.ts",
    "worker/shared/contracts/runtimeDiagnostics.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tooling/typecheck-contracts/browser.typecheck.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    // Lab Worker code: worker/tsconfig.lab.json types its Markdown imports.
    "src/apps/lab/content/promptLibrary.ts"
  ]
}
